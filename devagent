#!/usr/bin/env bash
# devagent — Local CLI file assistant for code exploration and editing.
# Uses Cerebras gpt-oss-120b with local file tools to analyze and propose changes.
#
# The Spring Boot agent must be running locally with the devagent profile:
#   SPRING_PROFILES_ACTIVE=devagent DEVAGENT_PROJECT_ROOT=$(pwd) \
#   CEREBRAS_API_KEY=... mvn spring-boot:run

set -euo pipefail

HOST="http://localhost:8080"

# ── Help text ─────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
Usage:
  devagent [flags] "goal description"
  devagent replay <run-file.json>
  echo "goal" | devagent [flags]

Flags:
  --help, -h           Show this help and exit
  --dry-run            Show proposed diffs without applying (default)
  --apply              Apply changes via git apply after confirmation
  --patch              Output combined unified patch to stdout
  --json               Output raw JSON response
  --yes                Skip confirmation with --apply
  --max-rounds N       Tool loop limit (default: 15)
  --allow GLOB         Add allowed write path (repeatable)
                       Default write paths: README.md, CLAUDE.md, CHANGELOG.md, docs/**, support-docs/**
                       Source edits need: --allow "src/**"

Subcommands:
  replay <file.json>   Display a saved run's analysis and diffs (no API call)

Examples:
  devagent "Find all REST API endpoints and list them"
  devagent --allow "src/**" "Fix the typo in ChatController"
  devagent --apply --yes "Add a TODO item to CLAUDE.md"
  devagent --patch "Update README" > changes.patch
  devagent replay .devagent/runs/2026-10-18T14-30-00.json

Environment:
  DEVAGENT_HOST        Override backend URL (default: http://localhost:8080)

The agent must be running locally:
  SPRING_PROFILES_ACTIVE=devagent DEVAGENT_PROJECT_ROOT=$(pwd) \
  CEREBRAS_API_KEY=... mvn spring-boot:run
EOF
}

# ── Colored diff rendering ────────────────────────────────────────────────

color_diff() {
    while IFS= read -r line; do
        case "$line" in
            "diff --git"*) printf '\033[1;33m%s\033[0m\n' "$line" ;;
            "new file"*)   printf '\033[1;33m%s\033[0m\n' "$line" ;;
            +++*|---*)     printf '\033[1m%s\033[0m\n' "$line" ;;
            @@*)           printf '\033[36m%s\033[0m\n' "$line" ;;
            +*)            printf '\033[32m%s\033[0m\n' "$line" ;;
            -*)            printf '\033[31m%s\033[0m\n' "$line" ;;
            *)             printf '%s\n' "$line" ;;
        esac
    done
}

# ── Replay subcommand ─────────────────────────────────────────────────────

do_replay() {
    local file="$1"
    if [ ! -f "$file" ]; then
        echo "Error: file not found: $file" >&2
        exit 1
    fi

    python3 -c '
import sys, json

with open(sys.argv[1]) as f:
    d = json.load(f)

print("=== Replay: " + d.get("goal", "") + " ===")
print()
print(d.get("analysis", "(no analysis)"))
print()

changes = d.get("changes", [])
if changes:
    print(f"--- {len(changes)} proposed change(s) ---")
    print()
    for c in changes:
        print(c.get("unifiedDiff", ""))
        print()

model = d.get("model", "")
ms = d.get("latencyMs", 0)
rounds = d.get("toolRounds", 0)
pt = d.get("promptTokens", 0)
ct = d.get("completionTokens", 0)
print(f"--- {model} | {ms}ms | {rounds} rounds | {pt}+{ct} tokens ---")
' "$file" | color_diff

    exit 0
}

# ── Parse flags ───────────────────────────────────────────────────────────

MODE="dry-run"
CONFIRM="yes"   # prompt by default
MAX_ROUNDS=15
ALLOW_PATHS=()
GOAL=""

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        replay)
            shift
            if [ $# -eq 0 ]; then
                echo "Error: replay requires a run file path" >&2
                usage
                exit 1
            fi
            do_replay "$1"
            ;;
        --dry-run)
            MODE="dry-run"
            shift
            ;;
        --apply)
            MODE="apply"
            shift
            ;;
        --patch)
            MODE="patch"
            shift
            ;;
        --json)
            MODE="json"
            shift
            ;;
        --yes)
            CONFIRM="no"
            shift
            ;;
        --max-rounds)
            shift
            if [ $# -eq 0 ]; then
                echo "Error: --max-rounds requires a number" >&2
                usage
                exit 1
            fi
            MAX_ROUNDS="$1"
            shift
            ;;
        --allow)
            shift
            if [ $# -eq 0 ]; then
                echo "Error: --allow requires a glob pattern" >&2
                usage
                exit 1
            fi
            ALLOW_PATHS+=("$1")
            shift
            ;;
        --*)
            echo "Error: unknown flag: $1" >&2
            echo "" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ -z "$GOAL" ]; then
                GOAL="$1"
            else
                GOAL="$GOAL $1"
            fi
            shift
            ;;
    esac
done

# Read from stdin if no goal from args
if [ -z "$GOAL" ] && [ ! -t 0 ]; then
    GOAL=$(cat)
fi

if [ -z "$GOAL" ]; then
    echo "Error: no goal provided" >&2
    echo "" >&2
    usage >&2
    exit 1
fi

# Override host if set
if [ -n "${DEVAGENT_HOST:-}" ]; then
    HOST="$DEVAGENT_HOST"
fi

# Check agent is reachable
if ! curl -sf -o /dev/null --max-time 2 "$HOST/" 2>/dev/null; then
    echo "Error: agent not reachable at $HOST" >&2
    echo "Start it with:" >&2
    echo "  SPRING_PROFILES_ACTIVE=devagent DEVAGENT_PROJECT_ROOT=\$(pwd) CEREBRAS_API_KEY=... mvn spring-boot:run" >&2
    exit 1
fi

# ── Build JSON request ────────────────────────────────────────────────────

JSON_GOAL=$(printf '%s' "$GOAL" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')

ALLOW_JSON="[]"
if [ ${#ALLOW_PATHS[@]} -gt 0 ]; then
    ALLOW_JSON=$(printf '%s\n' "${ALLOW_PATHS[@]}" | python3 -c 'import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
fi

BODY="{\"goal\": ${JSON_GOAL}, \"extraWritePaths\": ${ALLOW_JSON}, \"maxRounds\": ${MAX_ROUNDS}}"

# ── Call the endpoint ─────────────────────────────────────────────────────

echo "Thinking..." >&2

RESPONSE=$(curl -s "${HOST}/api/devagent" \
    -H 'Content-Type: application/json' \
    -d "$BODY")

# Check for errors
ERROR=$(echo "$RESPONSE" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("error",""))' 2>/dev/null || echo "")
if [ -n "$ERROR" ]; then
    echo "Error: $ERROR" >&2
    exit 1
fi

# ── Display results ───────────────────────────────────────────────────────

if [ "$MODE" = "json" ]; then
    echo "$RESPONSE" | python3 -m json.tool
    exit 0
fi

if [ "$MODE" = "patch" ]; then
    python3 -c '
import sys, json
d = json.load(sys.stdin)
for c in d.get("changes", []):
    print(c.get("unifiedDiff", ""))
' <<< "$RESPONSE"
    exit 0
fi

# dry-run or apply: show analysis and diffs
python3 -c '
import sys, json
d = json.load(sys.stdin)
print(d.get("analysis", ""))
' <<< "$RESPONSE"

echo ""

NUM_CHANGES=$(python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d.get("changes",[])))' <<< "$RESPONSE")

if [ "$NUM_CHANGES" -gt 0 ]; then
    echo "--- $NUM_CHANGES proposed change(s) ---"
    echo ""

    python3 -c '
import sys, json
d = json.load(sys.stdin)
for c in d.get("changes", []):
    print(c.get("unifiedDiff", ""))
    print()
' <<< "$RESPONSE" | color_diff
fi

# Footer
python3 -c '
import sys, json
d = json.load(sys.stdin)
model = d.get("model", "")
ms = d.get("latencyMs", 0)
rounds = d.get("toolRounds", 0)
pt = d.get("promptTokens", 0)
ct = d.get("completionTokens", 0)
changes = len(d.get("changes", []))
print(f"--- {model} | {ms}ms | {rounds} rounds | {changes} changes | {pt}+{ct} tokens ---")
' <<< "$RESPONSE"

# ── Apply mode ────────────────────────────────────────────────────────────

if [ "$MODE" = "apply" ] && [ "$NUM_CHANGES" -gt 0 ]; then
    # Ask for confirmation unless --yes
    if [ "$CONFIRM" = "yes" ]; then
        printf "\nApply %s change(s)? [y/N] " "$NUM_CHANGES"
        read -r answer
        if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
            echo "Aborted."
            exit 0
        fi
    fi

    # Write combined patch to temp file
    PATCH_FILE=$(mktemp /tmp/devagent-XXXXXX.patch)
    trap 'rm -f "$PATCH_FILE"' EXIT

    python3 -c '
import sys, json
d = json.load(sys.stdin)
for c in d.get("changes", []):
    print(c.get("unifiedDiff", ""))
' <<< "$RESPONSE" > "$PATCH_FILE"

    # Check first
    if ! git apply --check "$PATCH_FILE" 2>&1; then
        echo "" >&2
        echo "Error: git apply --check failed. The patch cannot be applied cleanly." >&2
        echo "Files may have changed since the analysis. Try running again." >&2
        exit 1
    fi

    # Apply
    git apply "$PATCH_FILE"
    echo ""
    echo "Applied $NUM_CHANGES change(s) successfully."
fi
